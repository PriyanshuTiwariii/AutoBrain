{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Result",
  "type": "object",
  "required": [
    "result_id",
    "dataset_version",
    "engine_version",
    "needs_summary",
    "slots",
    "unknowns",
    "disclaimer"
  ],
  "properties": {
    "result_id": {
      "type": "string"
    },
    "dataset_version": {
      "type": "string"
    },
    "engine_version": {
      "type": "string"
    },
    "needs_summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slot",
          "variant_key",
          "match_score",
          "confidence",
          "price_inr",
          "price_status",
          "metrics",
          "reasons",
          "tradeoffs",
          "watch_outs"
        ],
        "properties": {
          "slot": {
            "enum": [
              "best_match",
              "strong_alternative",
              "same_model",
              "in_between",
              "dont_overpay",
              "not_recommended"
            ]
          },
          "variant_key": {
            "type": "string"
          },
          "match_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "confidence": {
            "description": "Evidence confidence. Empty string for not_recommended slots (excluded cars get no confidence).",
            "enum": [
              "High",
              "Medium",
              "Low",
              ""
            ]
          },
          "price_inr": {
            "type": "integer"
          },
          "price_status": {
            "enum": [
              "verified",
              "corroborated",
              "pending"
            ]
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "string",
                "null"
              ]
            }
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "tradeoffs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "watch_outs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "savings_vs_best_inr": {
            "type": [
              "integer",
              "null"
            ]
          },
          "gap_filler_accessories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "accessory_key": {
                  "type": "string"
                },
                "price_inr": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disclaimer": {
      "type": "string"
    },
    "no_match": {
      "description": "Present (an object) only when no variant meets every need: why nothing qualifies, the closest option and what it would take. null otherwise.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "reasons",
        "closest_variant_key",
        "what_it_would_take"
      ],
      "additionalProperties": false,
      "properties": {
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "closest_variant_key": {
          "type": [
            "string",
            "null"
          ],
          "description": "variant_key of the closest option; it is also returned as a not_recommended slot."
        },
        "what_it_would_take": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}