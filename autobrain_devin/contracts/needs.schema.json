{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Needs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "budget_max_inr",
    "seats_min",
    "daily_km",
    "home_charging"
  ],
  "properties": {
    "budget_max_inr": {
      "type": "integer",
      "minimum": 300000
    },
    "budget_includes_charger": {
      "type": "boolean",
      "default": true
    },
    "seats_min": {
      "type": "integer",
      "minimum": 2,
      "maximum": 7
    },
    "daily_km": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "longest_regular_trip_km": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "home_charging": {
      "enum": [
        "yes",
        "no",
        "unsure"
      ]
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "body_types": {
      "type": "array",
      "items": {
        "enum": [
          "Hatchback",
          "Sedan",
          "SUV",
          "SUV coupé"
        ]
      },
      "default": []
    },
    "must_haves": {
      "type": "array",
      "items": {
        "enum": [
          "adas",
          "camera_360",
          "sunroof",
          "ventilated_seats",
          "esp",
          "awd",
          "seven_seats",
          "lifetime_battery_warranty",
          "crash_tested",
          "charger_included",
          "adaptive_suspension"
        ]
      },
      "default": []
    },
    "nice_to_haves": {
      "type": "array",
      "items": {
        "enum": [
          "adas",
          "camera_360",
          "sunroof",
          "ventilated_seats",
          "esp",
          "awd",
          "seven_seats",
          "lifetime_battery_warranty",
          "crash_tested",
          "charger_included",
          "adaptive_suspension"
        ]
      },
      "default": []
    },
    "priority": {
      "enum": [
        "balanced",
        "safety",
        "cost",
        "range",
        "features",
        "space"
      ],
      "default": "balanced"
    },
    "pricing_pref": {
      "enum": [
        "buy",
        "baas",
        "either"
      ],
      "default": "buy"
    },
    "exclude_models": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  }
}