# AutoBrain settings.
#
# Copy this file to ".env" in the same folder (the repo root) and fill in the values.
# ".env" is never committed. The engine and the website both read this one file.
# Write each line as NAME=value: no spaces around "=", and no quotes.
# Restart the engine and the website after you change it (it is read when they start).

# ---------------------------------------------------------------------------
# OpenAI API key  <-- paste your key here
# ---------------------------------------------------------------------------
# Used only by the two LLM steps (reading buyer text, wording explanations). Those steps are not built yet,
# so nothing reads this today. The whole demo works with it empty: form input plus templates.
# Keep it server-side: never put it in a NEXT_PUBLIC_ variable and never paste it into chat or a commit.
OPENAI_API_KEY=
# The OpenAI model names for the two LLM steps, exactly as OpenAI names them. Left empty until the LLM
# steps are built: the first is tried first, the second is the fallback.
LLM_MODEL_PRIMARY=
LLM_MODEL_FALLBACK=

# ---------------------------------------------------------------------------
# Engine (the recommendation service)
# ---------------------------------------------------------------------------
# Shared secret. The website sends it with every request and the engine checks it.
# The engine will not start if it is empty, and warns loudly while it is still "change-me".
ENGINE_SECRET=change-me
# Where the website finds the engine.
ENGINE_URL=http://localhost:8000
# Which data release the engine loads (relative to the repo root).
DATA_RELEASE_DIR=data/releases/2026-10-25-r2
# Development only. 1 lets a browser on http://localhost:3000 call the engine directly.
# Leave it 0: the website calls the engine from its server routes, never from the browser.
DEV_CORS=0

# ---------------------------------------------------------------------------
# Website: feedback link (optional)
# ---------------------------------------------------------------------------
# Your Google Form link. The website adds a random visit ID, the result ID, the dataset version and the top
# pick to it. Anything starting with NEXT_PUBLIC_ is visible to every visitor, so never put a secret here.
NEXT_PUBLIC_FEEDBACK_FORM_URL=
# Only for a Google Form with prefilled fields: the number in entry.123456789 for each field.
# Without them the details are added to the link as plain query values.
NEXT_PUBLIC_FEEDBACK_ENTRY_VISIT=
NEXT_PUBLIC_FEEDBACK_ENTRY_RESULT=
NEXT_PUBLIC_FEEDBACK_ENTRY_DATASET=
NEXT_PUBLIC_FEEDBACK_ENTRY_TOPPICK=
