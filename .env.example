# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Model ids for the two LLM calls (the demo works with these empty: form input + templates)
LLM_MODEL_PRIMARY=claude-haiku-5-5
LLM_MODEL_FALLBACK=claude-sonnet-5-5
# Engine
DATA_RELEASE_DIR=data/releases/2026-10-25-r2
ENGINE_URL=http://localhost:8000
# The engine refuses to start if this is empty and warns loudly while it is "change-me".
ENGINE_SECRET=change-me
# Development only. 1 lets a browser on http://localhost:3000 call the engine directly.
# Leave it 0: the website calls /recommend from its server routes, never from the browser.
DEV_CORS=0
# Web
# Link to your Google Form. The website adds a random visit ID, the result ID, the dataset
# version and the top pick to it. For a Google Form with prefilled fields, also set the entry
# numbers (the 123456789 in entry.123456789); without them the details go in as plain query values.
NEXT_PUBLIC_FEEDBACK_FORM_URL=
NEXT_PUBLIC_FEEDBACK_ENTRY_VISIT=
NEXT_PUBLIC_FEEDBACK_ENTRY_RESULT=
NEXT_PUBLIC_FEEDBACK_ENTRY_DATASET=
NEXT_PUBLIC_FEEDBACK_ENTRY_TOPPICK=
